generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String    @id @default(cuid())
  name       String
  email      String    @unique
  phone      String?
  photoUrl   String?
  password   String
  role       UserRole
  approved   Boolean   @default(false)    // admin approval required for drivers
  licenseType String?   // e.g. B Professional
  licenseNumber String?
  
  // documentos requeridos para conductores
  docCedulaVerdeFront String?   // path/url a cédula verde frente
  docCedulaVerdeBack String?    // path/url a cédula verde dorso
  docLicenseFront String?       // path/url a licencia frente
  docLicenseBack String?        // path/url a licencia dorso
  docCedulaFront String?        // path/url a cédula frente
  docCedulaBack String?         // path/url a cédula dorso
  docJudicialCert String?       // path/url a certificado de antecedentes
  
  // estado de documentos
  documentStatus DocumentStatus? @default(PENDING)  // PENDING, APPROVED, REJECTED
  rejectionReason String?  // motivo del rechazo si aplica
  
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  passengerRides Ride[] @relation("PassengerRides")
  driverRides    Ride[] @relation("DriverRides")
  vehicles       Vehicle[]
  notifications  Notification[]
  driverSessions DriverSession[]
  driverCommissionSettlements DriverCommissionSettlement[] @relation("DriverCommissionSettlements")
  managedCommissionDeposits DriverCommissionDeposit[] @relation("ManagedCommissionDeposits")
  driverCommissionDeposits DriverCommissionDeposit[] @relation("DriverCommissionDeposits")

  driverBlocked Boolean @default(false)
  driverBlockedReason String?
  commissionDebt Float @default(0)
  underchargeDebt Float @default(0)
  delinquencyCount Int @default(0)
  suspendedUntil DateTime?
}

enum UserRole {
  PASSENGER
  DRIVER
  ADMIN
}

model Vehicle {
  id         String   @id @default(cuid())
  placa      String
  marca      String?
  modelo     String?
  color      String?
  year       Int?     // año del vehículo
  capacidad  Int?
  estado     VehicleState

  driver   User?  @relation(fields: [driverId], references: [id], onDelete: SetNull)
  driverId String?

  rides Ride[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum VehicleState {
  DISPONIBLE
  OCUPADO
  MANTENIMIENTO
}

model Ride {
  id String @id @default(cuid())

  passenger   User   @relation("PassengerRides", fields: [passengerId], references: [id], onDelete: Cascade)
  passengerId String

  driver   User?  @relation("DriverRides", fields: [driverId], references: [id], onDelete: SetNull)
  driverId String?

  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleId String?

  originLat     Float
  originLng     Float
  destLat       Float
  destLng       Float
  estimatedFare Float
  finalFare     Float?
  officialFare   Float?
  collectedFare  Float?
  underchargeAmount Float? @default(0)
  adminFee      Float?
  driverEarnings Float?
  state         RideState
  acceptedAt    DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DriverCommissionSettlement {
  id        String @id @default(cuid())
  driver   User   @relation("DriverCommissionSettlements", fields: [driverId], references: [id], onDelete: Cascade)
  driverId String
  serviceDate DateTime
  amountDue Float @default(0)
  paidAt DateTime?
  receiptNumber String?
  status DriverCommissionSettlementStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([driverId, serviceDate])
  @@index([driverId, status])
}

model DriverCommissionDeposit {
  id        String @id @default(cuid())
  driver   User   @relation("DriverCommissionDeposits", fields: [driverId], references: [id], onDelete: Cascade)
  driverId String
  managedBy User? @relation("ManagedCommissionDeposits", fields: [managedById], references: [id], onDelete: SetNull)
  managedById String?
  driverName String
  managedByName String
  receiptNumber String
  amount Float
  delinquencyCountAtRelease Int
  managedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([driverId, managedAt])
}

enum DriverCommissionSettlementStatus {
  PENDING
  PAID
}

model DriverSession {
  id        String              @id @default(cuid())
  driver   User                @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId String
  status    DriverSessionStatus @default(ACTIVE)
  startedAt DateTime            @default(now())
  endedAt   DateTime?
  restUntil DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([driverId, status])
  @@index([driverId, restUntil])
}

enum DriverSessionStatus {
  ACTIVE
  COMPLETED
  RESTING
}

enum RideState {
  PENDIENTE
  ASIGNADO
  EN_CURSO
  FINALIZADO
  CANCELADO
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum NotificationType {
  APPROVED
  REJECTED
  RIDE_COMPLETED
  DOCUMENT_REJECTED
  OTHER
}

{
  "name": "monorepo-movi",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "dev:api": "npm run dev --workspace=api",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "build": "npm run build --workspace=web && npm run build --workspace=api"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "concurrently": "^8.2.0"
  },
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "prisma": "^6.18.0"
  }
}

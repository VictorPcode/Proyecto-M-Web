{
  "name": "monorepo-movi",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:free-ports": "node scripts/kill-ports-windows.js",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:local": "pnpm run dev:free-ports && concurrently \"pnpm --filter api dev\" \"pnpm --filter web dev\"",
    "dev:mobile": "pnpm run dev:free-ports && concurrently \"pnpm --filter api dev\" \"pnpm --filter web dev\"",
    "dev": "pnpm run dev:local",
    "build": "pnpm prisma generate && pnpm --filter web build && pnpm --filter api build"
  },
  "devDependencies": {
    "@prisma/client": "6.19.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.23",
    "concurrently": "^8.2.0",
    "create-next-app": "^16.1.1",
    "postcss": "^8.5.6",
    "prisma": "6.19.1",
    "tailwindcss": "^4.1.18",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.21",
    "dotenv": "^17.2.3",
    "leaflet": "^1.9.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-leaflet": "^5.0.0"
  },
  "packageManager": "pnpm@10.26.2"
}

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/movi?schema=public

# JWT
JWT_SECRET=your-secret-key-here

# Google APIs
GOOGLE_PLACES_API_KEY=your-google-places-api-key
GOOGLE_GEOCODING_API_KEY=your-google-geocoding-api-key

# Email (SMTP) - Para enviar correos de recuperación de contraseña
# Usa Gmail: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# Web URL
WEB_URL=http://localhost:3000

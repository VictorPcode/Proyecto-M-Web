{
  "extends": "../../tsconfig.json",

  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false,
    "composite": true,
    "declaration": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": false,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@movi/types": ["../../packages/types/src/index"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
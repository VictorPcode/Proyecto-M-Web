{
  "extends": "../../tsconfig.json",

  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false,
    "composite": true,
    "declaration": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": false,
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
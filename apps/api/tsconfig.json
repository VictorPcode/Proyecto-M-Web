{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "module": "Node16",
    "moduleResolution": "Node16",

    "baseUrl": ".",

    "paths": {
      "@movi/types": [
        "../../packages/types/dist/index.d.ts"
      ]
    },

    "rootDir": "src",
    "outDir": "dist",

    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false
  },

  "include": ["src/**/*"],

  "exclude": ["node_modules", "dist"]
}
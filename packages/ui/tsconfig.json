{
  "compilerOptions": {
    "target": "ES6",
    "module": "ESNext",
    "jsx": "react-jsx",
    "declaration": true,
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "ui": ["packages/ui"],
      "ui/*": ["packages/ui/*"]
    }
  },
  "include": ["*.ts", "*.tsx"]
}

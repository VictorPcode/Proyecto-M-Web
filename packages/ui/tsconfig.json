{
  "compilerOptions": {
    "target": "ES6",
    "module": "ESNext",

    "jsx": "react-jsx",

    "declaration": true,
    "outDir": "dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [],

    "lib": ["dom", "dom.iterable", "es6"],

    "moduleResolution": "bundler",
    "resolveJsonModule": true
  },

  "include": ["*.ts", "*.tsx"],

  "exclude": ["node_modules", "dist"]
}

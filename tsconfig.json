{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": [
      "DOM",
      "ES2022"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
  "@movi/types": ["packages/types/src"]
},
    "rootDir": ".",
    "outDir": "dist",
     "jsx": "react-jsx"
  },
  "include": [
    "packages/**/*",
    "apps/**/*"
  ]
}
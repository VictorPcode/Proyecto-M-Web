{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "lib": [
      "DOM",
      "ES2022"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "types": [],
    "rootDir": ".",
    "outDir": "dist",
     "jsx": "react-jsx"
  },
  "include": [
    "packages/**/*",
    "apps/**/*"
  ]
}